# Copy this file to .env.registry (gitignored, not committed) and fill in real values.
# Read by pull-latest-registry.sh and build-and-push-to-registry.sh to deploy/build against
# docker-compose.registry.yaml without committing environment-specific URLs to git.

SIGNALR_CLIENT_ENDPOINT=https://signalr-hub.example.net
# Include a non-default port here if your registry is exposed on one, e.g. host:47829/ns.
IMAGE_PREFIX=registry.example.net/registry/signalr-fun

# Optional. Hostname of a Service Bus emulator exposed outside Docker (e.g. via a reverse
# proxy), for cli/ServiceBusPostTool to use instead of sb://localhost. Only the host -- the
# rest of the emulator's fixed connection string is filled in automatically. Leave unset to
# always use localhost.
#SERVICEBUS_HOST=servicebus.example.net

# Optional. Set both if the registry requires authentication (e.g. REGISTRY_AUTH=htpasswd) --
# build-and-push-to-registry.sh and pull-latest-registry.sh will "docker login" with them
# before pushing/pulling. Leave unset for an unauthenticated registry.
#REGISTRY_USERNAME=
#REGISTRY_PASSWORD=
